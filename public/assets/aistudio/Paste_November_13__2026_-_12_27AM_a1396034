<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Bitácora de Riego</title>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#1e293b">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=Segoe+UI&display=swap" rel="stylesheet">
    <style>
        :root { 
            --bg-color: #1e293b; 
            --header-bg: #166534; 
            --text-color: #ffffff; 
            --input-bg: #ffffff; 
            --border-color: #334155; 
        }
        
        * { box-sizing: border-box; }
        
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: linear-gradient(rgba(30, 41, 59, 0.85), rgba(15, 23, 42, 0.9)), 
                        radial-gradient(circle at top left, #166534 0%, #1e293b 50%, #0f172a 100%);
            background-color: #1e293b; 
            color: var(--text-color); 
            padding: 15px; 
            margin: 0; 
            min-height: 100vh;
            -webkit-tap-highlight-color: transparent;
        }
        body::before {
            content: ""; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background-image: url('fondo.jpg'); background-size: cover; background-position: center;
            opacity: 0.25; z-index: -1;
        }

        /* --- MENÚ LATERAL --- */
        #sidebar {
            position: fixed; top: 0; left: 0; width: 85%; max-width: 300px; height: 100%;
            background-color: #0f172a; z-index: 10000; transform: translateX(-100%); transition: transform 0.3s ease;
            box-shadow: 4px 0 15px rgba(0,0,0,0.5); display: flex; flex-direction: column;
        }
        #sidebar.open { transform: translateX(0); }
        .sidebar-header { padding: 20px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; }
        .sidebar-header h3 { margin: 0; font-family: 'Montserrat', sans-serif; color: #10b981; font-size: 18px; }
        .close-sidebar { background: none; border: none; color: #fff; font-size: 32px; cursor: pointer; line-height: 1; }
        .sidebar-content { flex: 1; overflow-y: auto; padding: 15px; }
        .sidebar-footer { padding: 20px; border-top: 1px solid #334155; }
        .table-item { padding: 15px; background: #1e293b; margin-bottom: 10px; border-radius: 8px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-left: 4px solid transparent; }
        .table-item:active { background: #334155; }
        .table-item.active { border-left: 4px solid #166534; background: #14532d; }
        .table-name { font-weight: bold; font-size: 15px; flex: 1; }
        .delete-table { color: #ef4444; background: none; border: none; cursor: pointer; font-size: 18px; padding: 0 10px; }
        .btn-sidebar { width: 100%; padding: 15px; margin-bottom: 10px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 15px; }
        .btn-new-table { background-color: #166534; color: white; }
        .btn-logout-sidebar { background-color: #dc2626; color: white; }
        #sidebarOverlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; backdrop-filter: blur(2px); }
        #sidebarOverlay.open { display: block; }

        .container { max-width: 100%; margin: 0 auto; }
        
        /* ✅ CAMBIO AQUÍ: Login con imagen de fondo */
        #loginScreen { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.85)), 
                        url('fondo.jpg') no-repeat center center;
            background-size: cover;
            display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 9999; 
        }
        
        .login-box { background-color: #0f172a; padding: 30px 20px; border-radius: 15px; border: 1px solid var(--border-color); text-align: center; width: 85%; max-width: 320px; box-shadow: 0 15px 35px rgba(0,0,0,0.6); }
        .login-box input { width: 100%; padding: 15px; margin: 10px 0; border-radius: 8px; border: 1px solid #ccc; color: #000; box-sizing: border-box; font-size: 16px; }
        .login-box button { width: 100%; padding: 15px; background-color: #166534; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 16px; margin-top: 15px; }
        .login-error { color: #ef4444; font-size: 14px; margin-top: 15px; display: none; font-weight: bold;}

        #appContent { display: none; }
        header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #3b82f6; padding-bottom: 15px; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .header-left { display: flex; align-items: flex-start; gap: 15px; flex: 1; }
        .menu-btn { background: none; border: none; color: white; font-size: 32px; cursor: pointer; padding: 0; line-height: 1; margin-top: 5px;}
        h1 { margin: 0; font-size: 22px; font-family: 'Montserrat', sans-serif; text-shadow: 0 2px 4px rgba(0,0,0,0.5); line-height: 1.2; }
        .subtitle { font-size: 13px; color: #cbd5e1; margin-top: 5px; }
        .status-bar { font-size: 12px; color: #10b981; margin-top: 8px; display: flex; align-items: center; gap: 5px; }
        .status-dot { width: 8px; height: 8px; background-color: #10b981; border-radius: 50%; display: inline-block; }
        .user-info { font-size: 11px; color: #60a5fa; margin-top: 5px; font-weight: bold; }
        .top-inputs { text-align: right; font-size: 14px; width: 100%; }
        .top-inputs input { background: transparent; border: none; border-bottom: 1px solid #fff; color: #fff; width: 100%; max-width: 150px; text-align: right; padding: 5px 0; font-size: 14px;}
        
        /* --- VISTAS --- */
        .view-section { display: none; }
        .view-section.active { display: block; }
        
        /* --- TARJETAS DE LECTURA --- */
        .grilla-card {
            background: rgba(15, 23, 42, 0.95); border-radius: 10px; padding: 15px; margin-bottom: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3); border-left: 4px solid #166534;
        }
        .grilla-card-header {
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;
            padding-bottom: 10px; border-bottom: 1px solid #334155; flex-wrap: wrap; gap: 5px;
        }
        .grilla-date { font-weight: bold; font-size: 16px; color: #10b981; }
        .grilla-phase { font-size: 12px; color: #f59e0b; font-weight: bold; }
        
        .grilla-data { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
        .data-item { display: flex; flex-direction: column; gap: 3px; }
        .data-label { font-size: 11px; color: #94a3b8; font-weight: bold; text-transform: uppercase; }
        .data-value { font-size: 15px; color: #fff; font-weight: 500; }
        
        .grilla-nota {
            background: #1e293b; padding: 10px; border-radius: 6px; margin-bottom: 12px;
            font-size: 14px; color: #cbd5e1; font-style: italic;
        }
        .grilla-nota:empty { display: none; }
        
        .grilla-photo {
            width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 2px solid #3b82f6;
            cursor: pointer; margin-top: 8px;
        }
        
        .grilla-actions { display: flex; gap: 10px; margin-top: 12px; }
        .btn-edit { flex: 1; padding: 10px; background: #3b82f6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; }
        .btn-edit:active { background: #2563eb; }
        .btn-delete-grilla { padding: 10px 15px; background: #ef4444; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; }
        .btn-delete-grilla:active { background: #dc2626; }
        
        /* --- FORMULARIO DE INGRESO/EDICIÓN --- */
        .form-container {
            background: rgba(15, 23, 42, 0.95); border-radius: 10px; padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        .form-title { font-size: 18px; font-weight: bold; margin-bottom: 20px; color: #10b981; text-align: center; }
        
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-size: 12px; color: #94a3b8; font-weight: bold; text-transform: uppercase; margin-bottom: 5px; }
        
        .input-with-arrows {
            display: flex; align-items: stretch; gap: 0;
            border: 1px solid #94a3b8; border-radius: 6px; overflow: hidden;
            background: var(--input-bg);
        }
        .input-with-arrows input {
            flex: 1; border: none; padding: 12px; font-size: 16px; color: #000;
            background: transparent; outline: none; min-width: 0;
        }
        .arrow-buttons {
            display: flex; flex-direction: column; border-left: 1px solid #94a3b8;
        }
        .arrow-btn {
            flex: 1; border: none; background: #e2e8f0; cursor: pointer;
            font-size: 14px; font-weight: bold; color: #1e293b;
            display: flex; align-items: center; justify-content: center;
            padding: 0 12px; min-width: 36px;
        }
        .arrow-btn:active { background: #cbd5e1; }
        .arrow-btn.up { border-bottom: 1px solid #94a3b8; }
        
        .form-group input[type="date"],
        .form-group input[type="text"],
        .form-group select {
            width: 100%; padding: 12px; border: 1px solid #94a3b8; border-radius: 6px;
            background: var(--input-bg); color: #000; font-size: 16px; box-sizing: border-box;
        }
        
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        
        .photo-upload-area { text-align: center; margin: 15px 0; }
        .photo-btn {
            background: #3b82f6; color: white; border: none; padding: 12px; border-radius: 6px;
            font-size: 14px; cursor: pointer; width: 100%;
        }
        .photo-preview {
            width: 100px; height: 100px; object-fit: cover; border-radius: 8px; border: 2px solid #3b82f6;
            margin-top: 10px; display: none;
        }
        .photo-preview.has-image { display: inline-block; }
        
        .form-actions { display: flex; gap: 10px; margin-top: 20px; }
        .btn-save { flex: 1; padding: 14px; background: #166534; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 16px; }
        .btn-save:active { background: #14532d; }
        .btn-cancel { flex: 1; padding: 14px; background: #64748b; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 16px; }
        .btn-cancel:active { background: #475569; }
        
        .btn-add-riego {
            width: 100%; padding: 16px; background: #166534; color: white; border: none; border-radius: 8px;
            cursor: pointer; font-weight: bold; font-size: 16px; margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        .btn-add-riego:active { background: #14532d; }
        
        .empty-state { text-align: center; padding: 40px 20px; color: #94a3b8; }
        .empty-state-icon { font-size: 48px; margin-bottom: 10px; }
        
        #imageModal {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9); z-index: 20000; justify-content: center; align-items: center;
        }
        #imageModal.open { display: flex; }
        #modalImg { max-width: 95%; max-height: 90%; border-radius: 8px; }
        .close-modal { position: absolute; top: 20px; right: 20px; color: white; font-size: 40px; cursor: pointer; background: none; border: none;}
        
        @media (max-width: 400px) {
            .form-row { grid-template-columns: 1fr; }
            .grilla-data { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>

    <div id="sidebarOverlay" onclick="toggleSidebar()"></div>
    <div id="sidebar">
        <div class="sidebar-header">
            <h3>MIS TABLAS</h3>
            <button class="close-sidebar" onclick="toggleSidebar()">×</button>
        </div>
        <div class="sidebar-content" id="tableList"></div>
        <div class="sidebar-footer">
            <button class="btn-sidebar btn-new-table" onclick="createNewTable()">➕ NUEVA TABLA</button>
            <button class="btn-sidebar btn-logout-sidebar" onclick="logout()">🚪 CERRAR SESIÓN</button>
        </div>
    </div>

    <div id="loginScreen">
        <div class="login-box">
            <h2 style="margin-top:0; font-family:'Montserrat', sans-serif;">Acceso Restringido</h2>
            <p style="font-size:14px; color:#cbd5e1; margin-bottom: 20px;">Ingresá tus credenciales</p>
            <input type="email" id="loginEmail" placeholder="Correo electrónico">
            <input type="password" id="loginPassword" placeholder="Contraseña">
            <button onclick="login()">INGRESAR</button>
            <div id="loginError" class="login-error"></div>
        </div>
    </div>

    <div class="container" id="appContent">
        <header>
            <div class="header-left">
                <button class="menu-btn" onclick="toggleSidebar()">☰</button>
                <div>
                    <h1 id="currentTableTitle">Bitácora de Riego</h1>
                    <div class="subtitle">SEGUIMIENTO DE PLAN ALIMENTARIO</div>
                    <div class="status-bar">
                        <span class="status-dot" id="statusDot"></span>
                        <span id="statusText">Conectando...</span>
                    </div>
                    <div class="user-info" id="userInfo"></div>
                </div>
            </div>
            <div class="top-inputs">
                <div>Cultivo / Sala: <input type="text" id="cultivoInput"></div>
                <div style="margin-top:5px;">Sustrato / Maceta: <input type="text" id="sustratoInput"></div>
            </div>
        </header>

        <div id="viewRead" class="view-section active">
            <button class="btn-add-riego" onclick="showAddForm()">➕ AÑADIR NUEVO RIEGO</button>
            <div id="grillasList"></div>
        </div>

        <div id="viewForm" class="view-section">
            <div class="form-container">
                <div class="form-title" id="formTitle">NUEVO RIEGO</div>
                
                <div class="form-group">
                    <label>Fecha</label>
                    <input type="date" id="formFecha">
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>pH</label>
                        <div class="input-with-arrows">
                            <input type="number" step="0.1" id="formPH" placeholder="0.0">
                            <div class="arrow-buttons">
                                <button class="arrow-btn up" onclick="adjustValue('formPH', 0.1, 0, 14)">▲</button>
                                <button class="arrow-btn" onclick="adjustValue('formPH', -0.1, 0, 14)">▼</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>EC</label>
                        <div class="input-with-arrows">
                            <input type="number" step="0.1" id="formEC" onchange="calcPPMForm()" placeholder="0.0">
                            <div class="arrow-buttons">
                                <button class="arrow-btn up" onclick="adjustValue('formEC', 0.1, 0, 10)">▲</button>
                                <button class="arrow-btn" onclick="adjustValue('formEC', -0.1, 0, 10)">▼</button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>PPM</label>
                        <div class="input-with-arrows">
                            <input type="number" step="0.1" id="formPPM" readonly style="background:#e2e8f0;">
                            <div class="arrow-buttons">
                                <button class="arrow-btn up" style="opacity:0.3;" disabled>▲</button>
                                <button class="arrow-btn" style="opacity:0.3;" disabled>▼</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Temp (°C)</label>
                        <div class="input-with-arrows">
                            <input type="number" step="0.1" id="formTemp" placeholder="0.0">
                            <div class="arrow-buttons">
                                <button class="arrow-btn up" onclick="adjustValue('formTemp', 0.1, -10, 50)">▲</button>
                                <button class="arrow-btn" onclick="adjustValue('formTemp', -0.1, -10, 50)">▼</button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Agua (Litros)</label>
                    <div class="input-with-arrows">
                        <input type="number" step="0.5" min="0" id="formAgua" placeholder="0">
                        <div class="arrow-buttons">
                            <button class="arrow-btn up" onclick="adjustValue('formAgua', 0.5, 0, 100)">▲</button>
                            <button class="arrow-btn" onclick="adjustValue('formAgua', -0.5, 0, 100)">▼</button>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Acción / Nota</label>
                    <input type="text" id="formNota" placeholder="Descripción del riego...">
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Semana</label>
                        <select id="formSemana">
                            <option value="">Elegir...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Fase</label>
                        <select id="formFase">
                            <option value="">Elegir...</option>
                            <option value="VEG">🌱 VEG</option>
                            <option value="FLOR">🌸 FLOR</option>
                            <option value="CURADO">💨 CUR</option>
                        </select>
                    </div>
                </div>
                
                <div class="photo-upload-area">
                    <button class="photo-btn" onclick="document.getElementById('formFileInput').click()">📷 Sacar / Subir Foto</button>
                    <input type="file" id="formFileInput" accept="image/*" capture="environment" onchange="handleFormPhoto(this)" style="display:none;">
                    <img id="formPhotoPreview" class="photo-preview" onclick="openImageModal(this.src)" alt="Foto">
                </div>
                
                <div class="form-actions">
                    <button class="btn-cancel" onclick="cancelForm()">CANCELAR</button>
                    <button class="btn-save" onclick="saveForm()">💾 GUARDAR</button>
                </div>
            </div>
        </div>
    </div>

    <div id="imageModal" onclick="closeImageModal()">
        <button class="close-modal">×</button>
        <img id="modalImg" src="" alt="Foto del cultivo">
    </div>

    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyDhrCjhcLOGIQhYlz9_fnrtBVNVjDILQU0",
            authDomain: "bitacora-riego-1.firebaseapp.com",
            databaseURL: "https://bitacora-riego-1-default-rtdb.firebaseio.com",
            projectId: "bitacora-riego-1",
            storageBucket: "bitacora-riego-1.firebasestorage.app",
            messagingSenderId: "1004748759128",
            appId: "1:1004748759128:web:99abaa59cf8d6d2451ea2d"
        };

        try { firebase.initializeApp(firebaseConfig); } catch (e) { console.error(e); }

        const db = firebase.database();
        const auth = firebase.auth();
        const statusDot = document.getElementById('statusDot');
        const statusText = document.getElementById('statusText');
        const userInfo = document.getElementById('userInfo');
        const currentTableTitle = document.getElementById('currentTableTitle');
        
        let isSyncing = false;
        let currentTableId = null;
        let editingGrillaId = null;
        let currentTableData = null;
        let isSaving = false;

        function populateWeekSelect() {
            const select = document.getElementById('formSemana');
            select.innerHTML = '<option value="">Elegir...</option>';
            for (let i = 1; i <= 12; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.text = 'Sem ' + i;
                select.appendChild(option);
            }
        }
        populateWeekSelect();

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('open');
        }

        function login() {
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value.trim();
            if (!email || !password) { alert("Completá correo y contraseña."); return; }
            
            auth.signInWithEmailAndPassword(email, password)
                .then((userCredential) => {
                    document.getElementById('loginScreen').style.display = 'none';
                    document.getElementById('appContent').style.display = 'block';
                    userInfo.innerText = "Usuario: " + userCredential.user.email;
                    loadTableList();
                })
                .catch((error) => {
                    document.getElementById('loginError').style.display = 'block';
                    document.getElementById('loginError').innerText = "Error: " + error.message;
                });
        }

        function logout() { auth.signOut().then(() => { location.reload(); }); }

        auth.onAuthStateChanged((user) => {
            if (user) {
                document.getElementById('loginScreen').style.display = 'none';
                document.getElementById('appContent').style.display = 'block';
                userInfo.innerText = "Usuario: " + user.email;
                loadTableList();
            }
        });

        db.ref('.info/connected').on('value', (snap) => {
            if (snap.val() === true) {
                statusDot.style.backgroundColor = '#10b981';
                statusText.innerText = 'Conectado a la nube ✓';
            } else {
                statusDot.style.backgroundColor = '#f59e0b';
                statusText.innerText = 'Sin conexión';
            }
        });

        function getUserTablesRef() {
            if (!auth.currentUser) return null;
            return db.ref('bitacoras/' + auth.currentUser.uid + '/tablas');
        }

        function loadTableList() {
            const tablesRef = getUserTablesRef();
            tablesRef.once('value').then((snapshot) => {
                const listContainer = document.getElementById('tableList');
                listContainer.innerHTML = '';
                const data = snapshot.val();
                if (!data) { createNewTable("Mi Primera Tabla"); return; }

                Object.keys(data).forEach(tableId => {
                    const tableData = data[tableId];
                    const div = document.createElement('div');
                    div.className = 'table-item' + (tableId === currentTableId ? ' active' : '');
                    div.innerHTML = `
                        <span class="table-name" onclick="openTable('${tableId}')">${tableData.nombre}</span>
                        <button class="delete-table" onclick="deleteTable('${tableId}', event)">🗑️</button>
                    `;
                    listContainer.appendChild(div);
                });
            });
        }

        function createNewTable(defaultName = null) {
            const tableName = defaultName || prompt("Nombre de la nueva tabla:", "Nueva Tabla");
            if (!tableName) return;
            const newTableId = 'table_' + Date.now();
            const tablesRef = getUserTablesRef();
            tablesRef.child(newTableId).set({
                nombre: tableName, cultivo: "", sustrato: "", updatedAt: Date.now(), grillas: []
            }).then(() => { loadTableList(); openTable(newTableId); });
        }

        function openTable(tableId) {
            currentTableId = tableId;
            toggleSidebar(); 
            showReadView(); 
            
            db.ref('bitacoras/' + auth.currentUser.uid + '/tablas/' + tableId + '/nombre').once('value').then(snap => {
                currentTableTitle.innerText = snap.val() || "Bitácora";
            });

            const tableRef = db.ref('bitacoras/' + auth.currentUser.uid + '/tablas/' + tableId);
            tableRef.once('value').then((snapshot) => {
                const data = snapshot.val();
                if (!data) return;
                
                currentTableData = data;
                document.getElementById('cultivoInput').value = data.cultivo || '';
                document.getElementById('sustratoInput').value = data.sustrato || '';
                
                renderGrillasList();
                loadTableList();
            });
        }

        function renderGrillasList() {
            const container = document.getElementById('grillasList');
            container.innerHTML = '';
            
            if (!currentTableData || !currentTableData.grillas || currentTableData.grillas.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">📋</div>
                        <div>No hay riegos registrados</div>
                        <div style="font-size: 14px; margin-top: 10px;">Tocá "AÑADIR NUEVO RIEGO" para comenzar</div>
                    </div>
                `;
                return;
            }
            
            const grillasReversed = [...currentTableData.grillas].reverse();
            
            grillasReversed.forEach((grilla, index) => {
                const realIndex = currentTableData.grillas.length - 1 - index;
                const card = document.createElement('div');
                card.className = 'grilla-card';
                
                const fecha = grilla.fecha || 'Sin fecha';
                const fase = grilla.fase ? ` | ${grilla.fase}` : '';
                const semana = grilla.semana ? `Sem ${grilla.semana}` : '';
                
                let photoHtml = '';
                if (grilla.foto) {
                    photoHtml = `<img src="${grilla.foto}" class="grilla-photo" onclick="openImageModal(this.src)" alt="Foto">`;
                }
                
                card.innerHTML = `
                    <div class="grilla-card-header">
                        <div class="grilla-date">📅 ${fecha}</div>
                        <div class="grilla-phase">${semana}${fase}</div>
                    </div>
                    <div class="grilla-data">
                        <div class="data-item">
                            <div class="data-label">pH</div>
                            <div class="data-value">${grilla.ph || '-'}</div>
                        </div>
                        <div class="data-item">
                            <div class="data-label">EC</div>
                            <div class="data-value">${grilla.ec || '-'}</div>
                        </div>
                        <div class="data-item">
                            <div class="data-label">PPM</div>
                            <div class="data-value">${grilla.ppm || '-'}</div>
                        </div>
                        <div class="data-item">
                            <div class="data-label">Temp °C</div>
                            <div class="data-value">${grilla.temp || '-'}</div>
                        </div>
                        <div class="data-item">
                            <div class="data-label">Agua (L)</div>
                            <div class="data-value">${grilla.agua || '-'}</div>
                        </div>
                    </div>
                    ${grilla.nota ? `<div class="grilla-nota">📝 ${grilla.nota}</div>` : ''}
                    ${photoHtml}
                    <div class="grilla-actions">
                        <button class="btn-edit" onclick="editGrilla(${realIndex})">✏️ MODIFICAR</button>
                        <button class="btn-delete-grilla" onclick="deleteGrilla(${realIndex})">🗑️</button>
                    </div>
                `;
                
                container.appendChild(card);
            });
        }

        function deleteTable(tableId, event) {
            event.stopPropagation(); 
            if (!confirm("¿Eliminar esta tabla? No se puede deshacer.")) return;
            db.ref('bitacoras/' + auth.currentUser.uid + '/tablas/' + tableId).remove().then(() => {
                if (currentTableId === tableId) {
                    currentTableId = null;
                    currentTableData = null;
                    document.getElementById('grillasList').innerHTML = '';
                    document.getElementById('cultivoInput').value = '';
                    document.getElementById('sustratoInput').value = '';
                    currentTableTitle.innerText = "Bitácora de Riego";
                }
                loadTableList();
            });
        }

        function deleteGrilla(index) {
            if (!confirm("¿Eliminar este riego? No se puede deshacer.")) return;
            currentTableData.grillas.splice(index, 1);
            saveTableData();
        }

        function showReadView() {
            document.getElementById('viewRead').classList.add('active');
            document.getElementById('viewForm').classList.remove('active');
            editingGrillaId = null;
        }

        function showAddForm() {
            editingGrillaId = null;
            document.getElementById('formTitle').innerText = 'NUEVO RIEGO';
            clearForm();
            document.getElementById('viewRead').classList.remove('active');
            document.getElementById('viewForm').classList.add('active');
        }

        function editGrilla(index) {
            editingGrillaId = index;
            const grilla = currentTableData.grillas[index];
            
            document.getElementById('formTitle').innerText = 'MODIFICAR RIEGO';
            document.getElementById('formFecha').value = grilla.fecha || '';
            document.getElementById('formPH').value = grilla.ph || '';
            document.getElementById('formEC').value = grilla.ec || '';
            document.getElementById('formPPM').value = grilla.ppm || '';
            document.getElementById('formTemp').value = grilla.temp || '';
            document.getElementById('formAgua').value = grilla.agua || '';
            document.getElementById('formNota').value = grilla.nota || '';
            document.getElementById('formSemana').value = grilla.semana || '';
            document.getElementById('formFase').value = grilla.fase || '';
            
            const preview = document.getElementById('formPhotoPreview');
            if (grilla.foto) {
                preview.src = grilla.foto;
                preview.classList.add('has-image');
            } else {
                preview.src = '';
                preview.classList.remove('has-image');
            }
            
            document.getElementById('viewRead').classList.remove('active');
            document.getElementById('viewForm').classList.add('active');
        }

        function cancelForm() {
            showReadView();
        }

        function clearForm() {
            document.getElementById('formFecha').value = '';
            document.getElementById('formPH').value = '';
            document.getElementById('formEC').value = '';
            document.getElementById('formPPM').value = '';
            document.getElementById('formTemp').value = '';
            document.getElementById('formAgua').value = '';
            document.getElementById('formNota').value = '';
            document.getElementById('formSemana').value = '';
            document.getElementById('formFase').value = '';
            const preview = document.getElementById('formPhotoPreview');
            preview.src = '';
            preview.classList.remove('has-image');
            document.getElementById('formFileInput').value = '';
        }

        function adjustValue(inputId, step, min, max) {
            const input = document.getElementById(inputId);
            let val = parseFloat(input.value) || 0;
            val = Math.round((val + step) * 10) / 10;
            if (val < min) val = min;
            if (val > max) val = max;
            input.value = val;
            if (inputId === 'formEC') {
                calcPPMForm();
            }
        }

        function calcPPMForm() {
            const ec = parseFloat(document.getElementById('formEC').value);
            const ppmInput = document.getElementById('formPPM');
            ppmInput.value = (!isNaN(ec)) ? (ec * 0.5).toFixed(1) : '';
        }

        function handleFormPhoto(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        const ctx = canvas.getContext('2d');
                        const maxWidth = 600;
                        const scaleSize = maxWidth / img.width;
                        canvas.width = maxWidth;
                        canvas.height = img.height * scaleSize;
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                        
                        const compressedBase64 = canvas.toDataURL('image/jpeg', 0.6);
                        const preview = document.getElementById('formPhotoPreview');
                        preview.src = compressedBase64;
                        preview.classList.add('has-image');
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function saveForm() {
            if (isSaving) return;
            isSaving = true;
            
            const grilla = {
                fecha: document.getElementById('formFecha').value,
                ph: document.getElementById('formPH').value,
                ec: document.getElementById('formEC').value,
                ppm: document.getElementById('formPPM').value,
                temp: document.getElementById('formTemp').value,
                agua: document.getElementById('formAgua').value,
                nota: document.getElementById('formNota').value,
                semana: document.getElementById('formSemana').value,
                fase: document.getElementById('formFase').value,
                foto: document.getElementById('formPhotoPreview').classList.contains('has-image') 
                      ? document.getElementById('formPhotoPreview').src : ''
            };
            
            if (!currentTableData.grillas) {
                currentTableData.grillas = [];
            }
            
            if (editingGrillaId !== null) {
                currentTableData.grillas[editingGrillaId] = grilla;
            } else {
                currentTableData.grillas.push(grilla);
            }
            
            saveTableData().then(() => {
                isSaving = false;
                showReadView();
            }).catch(() => {
                isSaving = false;
            });
        }

        function saveTableData() {
            if (!currentTableId || !auth.currentUser) return Promise.resolve();
            if (isSyncing) return Promise.resolve();
            
            isSyncing = true;
            const tableRef = db.ref('bitacoras/' + auth.currentUser.uid + '/tablas/' + currentTableId);
            
            const data = {
                nombre: currentTableData.nombre || "Sin Nombre",
                cultivo: document.getElementById('cultivoInput').value,
                sustrato: document.getElementById('sustratoInput').value,
                updatedAt: Date.now(),
                grillas: currentTableData.grillas || []
            };
            
            return tableRef.set(data).then(() => {
                setTimeout(() => { isSyncing = false; }, 300);
                renderGrillasList();
            }).catch(err => { 
                console.error("Error:", err); 
                isSyncing = false; 
                return Promise.reject(err);
            });
        }

        function openImageModal(src) {
            document.getElementById('modalImg').src = src;
            document.getElementById('imageModal').classList.add('open');
        }

        function closeImageModal() {
            document.getElementById('imageModal').classList.remove('open');
        }

        document.getElementById('cultivoInput').addEventListener('input', () => {
            if (currentTableData) {
                currentTableData.cultivo = document.getElementById('cultivoInput').value;
                saveTableData();
            }
        });
        
        document.getElementById('sustratoInput').addEventListener('input', () => {
            if (currentTableData) {
                currentTableData.sustrato = document.getElementById('sustratoInput').value;
                saveTableData();
            }
        });
    </script>
</body>
</html>